{
  "name": "ciberheroes",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
  "start": "node app.js",
  "test": "jest",
  "test:coverage": "jest --coverage --ci --runInBand",
  "lint": "eslint . --ext .js --max-warnings=0"
},
"jest": {
  "testEnvironment": "node",
  "testMatch": ["**/tests/**/*.js"],
  "collectCoverageFrom": [
    "app.js",
    "backend/src/**/*.js",
    "!backend/src/server.js",
    "!**/*.test.js"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 85,
      "functions": 85,
      "lines": 85,
      "statements": 85
    }
  }
},
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.1.3",
    "eslint": "^8.55.0",
    "eslint-plugin-security": "^2.1.0"
  }
}
