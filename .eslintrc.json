{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:security/recommended-legacy"
  ],
  "overrides": [
    {
      "files": [
        "frontend/**/*.js"
      ],
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
      }
    },
    {
      "files": [
        "tests/**/*.js"
      ],
      "env": {
        "jest": true
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "coverage/"
  ]
}
