{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:security/recommended-legacy"
  ],
  "overrides": [
    {
      "files": ["tests/**/*.js", "backend/tests/**/*.js"],
      "env": {
        "jest": true
      }
    },
    {
      "files": ["frontend/*.config.js"],
      "parserOptions": {
        "sourceType": "module",
        "ecmaVersion": "latest"
      },
      "env": {
        "node": true,
        "es2022": true
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "coverage/",
    "frontend-temporal/",
    "frontend-respaldo/"
  ]
}